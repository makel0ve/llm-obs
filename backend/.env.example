ENVIRONMENT=development
SECRET_KEY=your-random-32-char-secret-key-here

# For production, copy backend/.env.prod.example instead of this development
# example. Production startup validation rejects localhost service URLs,
# wildcard CORS origins and placeholder/default secrets.

DATABASE_URL=postgresql+asyncpg://llmobs_app:llmobs_dev@postgres:5432/llmobs
MIGRATION_DATABASE_URL=postgresql+asyncpg://llmobs_owner:llmobs_owner_dev@postgres:5432/llmobs
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2

REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_URL=redis://redis-queue:6379/0

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

API_RATE_LIMIT_PER_MINUTE=1000
CORS_ALLOWED_ORIGINS=http://localhost:3000

S3_BUCKET=llm-obs-payloads
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123

DEFAULT_RETENTION_DAYS=90

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@llm-obs.io

POSTGRES_DB=llmobs
POSTGRES_USER=llmobs_owner
POSTGRES_PASSWORD=llmobs_owner_dev
POSTGRES_APP_USER=llmobs_app
POSTGRES_APP_PASSWORD=llmobs_dev
POSTGRES_HOST=postgres

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
