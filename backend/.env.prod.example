ENVIRONMENT=production
SECRET_KEY=replace-with-random-64-hex-character-secret

DATABASE_URL=postgresql+asyncpg://app_user:replace-with-app-db-password@pgbouncer:6432/llmobs
MIGRATION_DATABASE_URL=postgresql+asyncpg://db_owner:replace-with-owner-db-password@postgres:5432/llmobs
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2

REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_URL=redis://redis-queue:6379/0

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

API_RATE_LIMIT_PER_MINUTE=1000
CORS_ALLOWED_ORIGINS=https://dashboard.example.com

S3_BUCKET=llm-obs-payloads
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=replace-with-s3-access-key
AWS_SECRET_ACCESS_KEY=replace-with-s3-secret-key

DEFAULT_RETENTION_DAYS=90

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com

POSTGRES_DB=llmobs
POSTGRES_PORT=5432
POSTGRES_USER=db_owner
POSTGRES_PASSWORD=replace-with-owner-db-password
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=replace-with-app-db-password
POSTGRES_HOST=postgres

MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-minio-root-password
